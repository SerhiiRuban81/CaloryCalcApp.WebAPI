                    valueSelector2: item => $"<a class='btn btn-warning me-2' href='/HealthyUsers/Edit/{item.Id}'>Edit</a> <a class='btn btn-danger ms-2' href='/HealthyUsers/Delete/{item.Id}'>Delete</a>",
                    currentPage: userPage,
                    pageSize: 10,
                    searchText: Model.SearchText,
                    searchType: Model.SearchType,
                    pageParameterName: "userPage"
                    );
                    @Html.Raw(tableHtml)

