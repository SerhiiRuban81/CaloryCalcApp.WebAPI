@using Azure.Core
@using CaloryCalcApp.WebAPI.Models.ViewModels.Search
@using Microsoft.AspNetCore.Http.Extensions
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model CaloryCalcApp.WebAPI.Models.ViewModels.Search.SearchViewModel

<form>
    <h2>Search results</h2>
    @{
        if (Model.SearchType == "Product")
        {
            <h2>Products</h2>
            <h2>
                found for the item `@Html.Raw(Model.SearchText)`
            </h2>
            @if (Model.ProductsFound.Any())
            {
                <h3>Products</h3>
                // Version with PaginationHelperSearch
                int productPage = ViewBag.ProductPage is int p ? p : 1;
                
                string tableHtml = PaginationHelperSearch.RenderPagination(
                list: Model.ProductsFound,
                caption1: "Name",
                caption2: "Actions",
                valueSelector1: item => item.Name,
                valueSelector2: item => $"<a href='/Products/Edit/{item.Id}'>Edit</a> <a href='/Products/Details/{item.Id}'>Details</a> <a href='/Products/Delete/{item.Id}'>Delete</a>",
                currentPage: productPage,
                pageSize: 10,
				searchText: Model.SearchText,
				searchType: Model.SearchType,
                pageParameterName: "productPage"
            );
                @Html.Raw(tableHtml)
            }
            else
            {
                <h2>No products `@Html.Raw(Model.SearchText)` were found.</h2>
            }
        }
        ///////////////////////////////////////////////
        ///   DISH
        ///////////////////////////////////////////////
        else if (Model.SearchType == "Dish")
        {
            <h2>Dishes found for the `@Html.Raw(Model.SearchText)`
            </h2>
            @if (Model.DishesFound.Any())
            {
                // Using PaginationHelperSearch
                int dishPage = ViewBag.DishPage is int d ? d : 1;
                string tableHtml = PaginationHelperSearch.RenderPagination(
                    list: Model.DishesFound,
                    caption1: "Name",
                    caption2: "Actions",
                    valueSelector1: item => item.Name,
                    valueSelector2: item => $"<a href='/Dishes/Edit/{item.Id}'>Edit</a> <a href='/Dishes/Details/{item.Id}'>Details</a> <a href='/Dishes/Delete/{item.Id}'>Delete</a>",
                    currentPage: dishPage,
                    pageSize: 10,
                    searchText: Model.SearchText,
                    searchType: Model.SearchType,
                    pageParameterName: "dishPage"
                );
                @Html.Raw(tableHtml)
            }
            else
            {
                <h2>No dishes `@Html.Raw(Model.SearchText)` were found.</h2>
            }
        }

