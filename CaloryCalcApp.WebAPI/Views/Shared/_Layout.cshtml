<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width">
    <title>@ViewBag.Title</title>
    <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/style.css" rel="stylesheet" />
</head>
<body>

    @* Header *@
    <header class="p-3 text-bg-light">
        <div class="container-fluid">
            <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-lg-start">
                <a href="/" class="d-flex align-items-center mb-2 mb-lg-0 text-dark text-decoration-none">
                    <span class="brand-label">CaloryCalc</span>
                </a>

                <ul class="nav col-12 col-lg-auto me-lg-auto mb-2 justify-content-center mb-md-0">

                    <li><a asp-action="Index" asp-controller="Home" class="nav-link px-2 text-dark">Home</a></li>
                    <li><a asp-action="Statistics" asp-controller="HealthyUserDishes" class="nav-link px-2 text-dark">Statistics</a></li>
                    <li><a asp-action="Index" asp-controller="Products" class="nav-link px-2 text-dark">Products</a></li>
                    <li><a asp-action="Index" asp-controller="Dishes" class="nav-link px-2 text-dark">Dishes</a></li>
                    <li><a asp-action="Index" asp-controller="HealthyUserDishes" class="nav-link px-2 text-dark">HealthyUserDishes</a></li>
                    <li><a asp-action="UserDetails" asp-controller="HealthyUsers" class="nav-link px-2 text-dark">Target</a></li>
                    <li><a asp-action="Index" asp-controller="HealthyUsers" class="nav-link px-2 text-dark">Users</a></li>

                    @* <li class="nav-item dropdown">
                        <a class="nav-link text-dark dropdown-toggle" role="button" data-bs-toggle="dropdown" aria-expanded="false">Category</a>
                        <a class="nav-link text-white dropdown-toggle" role="button" data-bs-toggle="dropdown" aria-expanded="false">Category</a>
                        <ul class="dropdown-menu" style="min-width: 40vw;">
                            @await Component.InvokeAsync("CategoryMenu")
                        </ul>
                    </li> *@
                    @* <li><a asp-action="Index" asp-controller="ProductImages" class="nav-link px-2 text-dark">Images</a></li> *@

                    @* @if (User.Identity != null && User.IsInRole("Admin"))
                    {
                        <li>
                            <a asp-action="Index" asp-controller="Users"
                               class="nav-link px-2 text-dark">Users</a>
                        </li>
                        <li>
                            <a asp-action="Index" asp-controller="Roles"
                               class="nav-link px-2 text-dark">Roles</a>
                        </li>
                    } *@


                </ul>
                <form asp-controller="Search" asp-action="Search" method="post" class="col-12 col-lg-auto mb-3 mb-lg-0 me-lg-3" role="search">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <div class="row g-2 align-items-center">

                            <!-- Search text -->
                            <div class="col-md-5">
                                <input type="search"
                                       name="SearchText"
                                       class="form-control form-control-lg"
                                       placeholder="Search..."
                                       aria-label="Search" />
                            </div>

                            <!-- Search type dropdown -->
                            <div class="col-md-4">
                                <select id="SearchType"
                                        name="SearchType"
                                        class="form-select form-select-lg">
                                    <option value="Product">Product</option>
                                    <option value="Dish">Dish</option>
                                    @* Commented below part is under construction *@
                                    @* <option value="User">User</option>
                                     <option value="FullSearch">Full search</option> *@
                                </select>
                            </div>

                            <!-- Search button -->
                            <div class="col-md-1 d-grid">
                                <button type="submit" class="btn btn-primary btn-lg">
                                    Search
                                </button>
                            </div>

                        </div>

                        // Version below is before implementing more beautiful, temporary spare
                        /*<input type="search" name="SearchText" class="form-control" placeholder="Search..." aria-label="Search" />
                        <select id="SearchType" name="SearchType" aria-label="Select Entity" class="form-select">
                            <option value="Product">Product</option>
                            <option value="Dish">Dish</option>
                            @* Commented part below is under construction *@
                            @* <option value="User">User</option>
                            <option value="FullSearch">Full search</option> *@
                        </select>
                        <button type="submit" class="btn btn-primary">Search</button>*/
                    }
                </form>
                
                <div class="text-end me-lg-3">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <span class="me-2">Hello, @User.Identity.Name</span>
                        <a asp-action="Logout" asp-controller="Account" class="btn btn-outline-secondary me-2">Logout</a>
                    }
                    else
                    {
                        <a asp-action="Login" asp-controller="Account" class="btn btn-outline-secondary me-2">Login</a>
                        <a asp-action="Register" asp-controller="Account" class="btn btn-warning">Sign-up</a>
                    }
                </div>
            </div>
        </div>
    </header>
    <div id="main" class="container">
        @RenderBody()
    </div>

    @* Footer *@
    <footer class="container py-5">
        <div class="row">
            <div class="col-6 col-md-2 mb-3">
                <h5>Section</h5>
                <ul class="nav flex-column">
                    <li class="nav-item mb-2"><a asp-action="Index" asp-controller="Home" class="nav-link p-0 text-body-secondary">Home</a></li>
                    @* <li class="nav-item mb-2"><a href="#" class="nav-link p-0 text-body-secondary">Features</a></li> *@
                    @* <li class="nav-item mb-2"><a href="#" class="nav-link p-0 text-body-secondary">Pricing</a></li> *@
                    @* <li class="nav-item mb-2"><a href="#" class="nav-link p-0 text-body-secondary">FAQs</a></li> *@
                    <li class="nav-item mb-2"><a href="#" class="nav-link p-0 text-body-secondary">About</a></li>
                </ul>
            </div>


            <div class="col-md-5 offset-md-1 mb-3">
                <form>
                    <h5>Subscribe to our newsletter</h5>
                    <p>Monthly digest of what's new and exciting from us.</p>
                    <div class="d-flex flex-column flex-sm-row w-100 gap-2">
                        <label for="newsletter1" class="visually-hidden">Email address</label>
                        <input id="newsletter1" type="email" class="form-control" placeholder="Email address">
                        <button class="btn btn-primary" type="button">Subscribe</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="d-flex flex-column flex-sm-row justify-content-between py-4 my-4 border-top">
            <p>© @DateTime.Now.Year PV312TeamCompany, Inc. All rights reserved.</p>
            <ul class="list-unstyled d-flex">
                <li class="ms-3"><a class="link-body-emphasis" href="#" aria-label="Instagram"><svg class="bi" width="24" height="24"><use xlink:href="#instagram"></use></svg></a></li>
                <li class="ms-3"><a class="link-body-emphasis" href="#" aria-label="Facebook"><svg class="bi" width="24" height="24" aria-hidden="true"><use xlink:href="#facebook"></use></svg></a></li>
            </ul>
        </div>
    </footer>



    
    <script src="~/lib/bootstrap/js/bootstrap.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

