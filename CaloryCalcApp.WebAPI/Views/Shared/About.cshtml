@{
    ViewData["Title"] = "About Our Calories Calculator";
}

<div class="about-container">
    <h1 class="main-heading">Welcome to Calories Calculator!</h1>
    <p class="intro-text">
        Embark on a journey to healthier living with our intuitive and easy-to-use calorie tracking app. Whether you're aiming to shed a few pounds, gain muscle, or simply stay mindful of your nutrition, we've got you covered!
    </p>

    <section class="features-section">
        <h2>What Makes Us Special?</h2>
        <ul class="features-list">
            <li><strong>Smart Tracking:</strong> Log your meals with just a few taps and watch your daily calorie intake stay in check.</li>
            <li><strong>Personalized Goals:</strong> Set your targets and follow them step by step.</li>
            <li><strong>Progress Insights:</strong> Visual graphs and stats to motivate and inform your journey.</li>
        </ul>
    </section>

    <section class="how-it-works">
        <h2>How Does It Work?</h2>
        <p>
            It's simple! Just enter what you've eaten, and our app will instantly calculate the calories. 
        </p>
    </section>

    <section class="team-section">
        <h2>Meet the Team</h2>
        <p>
            Behind this project is a passionate team dedicated to making health and wellness accessible for everyone. We believe in empowering you with the tools to make smarter choices—and having fun along the way!
        </p>
    </section>

    <section class="privacy-section">
        <h2>Privacy & Security</h2>
        <p>
            Your data is safe with us. We prioritize your privacy and ensure your information stays confidential. Your trust is our top priority.
        </p>
    </section>

</div>


<style>
    .about-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 30px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        line-height: 1.6;
        color: #333;
        background-color: #f9f9f9;
        border-radius: 10px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .main-heading {
        text-align: center;
        color: #47d183;
        margin-bottom: 20px;
    }

    .intro-text {
        text-align: center;
        font-size: 1.2em;
        margin-bottom: 30px;
    }

    h2 {
        color: #47d183;
        margin-top: 40px;
    }

    .features-list {
        list-style: disc inside;
        margin-top: 15px;
    }

    .features-list li {
        margin-bottom: 10px;
    }

    .how-it-works, .team-section, .privacy-section {
        margin-top: 30px;
    }

    .cta-section {
        text-align: center;
        margin-top: 50px;
    }

</style>