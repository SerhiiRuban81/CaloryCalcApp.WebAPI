@using CaloryCalcApp.WebAPI.Models.ViewModels.Claims;
@model IndexClaimsVM
@{
    ViewData["Title"] = "Index";
}

<h1>Claim about User @Model.UserName</h1>
<h2>Email: @Model.Email</h2>
<a asp-action="Create">Add claim</a>
<hr />
@if(Model.Claims!=null && Model.Claims.Count() > 0)
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Claim type</th>
                <th>Value</th>
                <th>Value type</th>
                <th>Issuer</th>
                <th></th>
            </tr>            
        </thead>
        <tbody>
            @foreach(var claim in Model.Claims)
            {
                <tr>
                    <td>@claim.Type</td>
                    <td>@claim.Value</td>
                    <td>@claim.ValueType</td>
                    <td>@claim.Issuer</td>
                    <td>
                        <form asp-action="Delete" method="post">
                            <input type="hidden" name="claimValues"
                                value="@claim.Type;@claim.Value;@claim.Issuer"
                            />
							<button type="submit" class="btn btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
			}
	)
        </tbody>
    </table>
}
else
{
    <p>No claims found for this user.</p>
}
)

