@{
}
@model List<CaloryCalcApp.WebAPI.Models.DTOs.HealthyUserDishes.HealthyUserDishDTO>
<!-- Include Chart.js library -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<h1>Statistics</h1>

<!-- Form with dropdown -->
<form method="get" id="timeForm">
    <label for="daysSelect">Please select time period:</label>

    <select id="daysSelect" name="days" class="form-select" onchange="document.getElementById('timeForm').submit();">
        @foreach (var option in (List<SelectListItem>)ViewBag.TimeOptions)
        {
            <option value="@option.Value" selected="@(option.Value == ViewBag.SelectedDays)"> @option.Text </option>
        }
    </select>
</form>

<canvas id="CaloryCalcChart" width="800" height="400"></canvas>





<script>
    // Parsing the JSON data passed from controller
    const dataPoints = JSON.parse('@Html.Raw(ViewBag.MealData)');

    // Preparing labels (dates)
    const labels = dataPoints.map(dp => dp.DateTime);

    // Preparing datasets
    const caloriesData = dataPoints.map(dp => dp.TotalCalories);
    const fatsData = dataPoints.map(dp => dp.TotalFats);
    const proteinsData = dataPoints.map(dp => dp.TotalProteins);
    const carbsData = dataPoints.map(dp => dp.TotalCarbohydrates);

    // Creating the chart
    const ctx = document.getElementById('CaloryCalcChart').getContext('2d');
    const myChart = new Chart(ctx, {
        type: 'line', // or 'bar', 'area', etc.
        data: {
            labels: labels,
            datasets: [
                {
                    label: 'Calories',
                    data: caloriesData,
                    borderColor: 'rgba(255, 99, 132, 1)',
                    backgroundColor: 'rgba(255, 99, 132, 0.2)',
                    fill: false,
                    tension: 0.4
                },
                {
                    label: 'Fats (g)',
                    data: fatsData,
                    borderColor: 'rgba(54, 162, 235, 1)',
                    backgroundColor: 'rgba(54, 162, 235, 0.2)',
                    fill: false,
                    tension: 0.4
                },
                {
                    label: 'Proteins (g)',
                    data: proteinsData,
                    borderColor: 'rgba(75, 192, 192, 1)',
                    backgroundColor: 'rgba(75, 192, 192, 0.2)',
                    fill: false,
                    tension: 0.4
                },
                {
                    label: 'Carbohydrates (g)',
                    data: carbsData,
                    borderColor: 'rgba(153, 102, 255, 1)',
                    backgroundColor: 'rgba(153, 102, 255, 0.2)',
                    fill: false,
                    tension: 0.4
                }
            ]
        },
        options: {
            responsive: true,
            plugins: {
                title: {
                    display: true,
                    text: 'Nutritional Data Over Time'
                },
                tooltip: {
                    mode: 'index',
                    intersect: false,
                },
                legend: {
                    position: 'top',
                }
            },
            interaction: {
                mode: 'nearest',
                axis: 'x',
                intersect: false
            },
            scales: {
                x: {
                    display: true,
                    title: {
                        display: true,
                        text: 'Date and Time'
                    }
                },
                y: {
                    display: true,
                    title: {
                        display: true,
                        text: 'Amount'
                    }
                }
            }
        }
    });
</script>




