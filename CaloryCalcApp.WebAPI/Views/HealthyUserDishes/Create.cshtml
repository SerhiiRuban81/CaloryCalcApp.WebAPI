@* @model CaloryCalcLibrary.HealthyUserDish *@
@model CaloryCalcApp.WebAPI.Models.DTOs.HealthyUserDishes.HealthyUserDishDTO;

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>HealthyUserDish</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="DishId" class="control-label"></label>
                <select asp-for="DishId" class ="form-control" asp-items="ViewBag.DishId"></select>
            </div>
            <div class="form-group">
                <label asp-for="Amount" class="control-label"></label>
                <input asp-for="Amount" class="form-control" />
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>
			@* Приховано. Можна додати, якщо потрібна можливість вибору користувача при створенні страви для користувача (тобто записати страву комусь, наприклад дитині, не заходячи в інший акаунт). *@
            @* <div class="form-group"> *@
            <div class="form-group" style="display:none;">            
                <label asp-for="HealthyUserId" class="control-label"></label>
                <select asp-for="HealthyUserId" class="form-control" asp-items="ViewBag.HealthyUserId" asp-route-Value="@ViewBag.CurrentUserId"></select>
            </div>
            @* Hidden input for date time *@
            <input type="hidden" id="DateTimeInput" name="DateTime" value="@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")">
            <div class="form-group">
                <label asp-for="MealTime" class="control-label"></label>
                <input asp-for="MealTime" class="form-control" type="datetime" value="@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")" />
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index" class="btn btn-sm btn-success my-2">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
<script>
    // Get the current date and time
    var currentDate = new Date();
    var currentDateTime = currentDate.toLocaleString();

    // Set the current date and time as the default value for the input fields
    document.getElementById("DateTimeInput").value = currentDateTime;
</script>