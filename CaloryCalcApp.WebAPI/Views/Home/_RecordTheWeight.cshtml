@model string
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@


@{

    <div class="d-flex flex-column align-items-center text-center">
        <a asp-controller="HealthyUsers"
           asp-action="WeightUpdate" asp-route-id="@Model"
        style="background-color: #f0af37ff;
                    border-radius: 50px;
                    width: 70px;
                    height: 70px;"
                class="btn d-flex align-items-center justify-content-center">
            <img style="
                        width: 100%;
                        height: 100%;"
                 src="~/images/weight-scale_17534006.png"
                 alt="record weight" />
        </a>
        <p class="mt-2">
            Record weight
        </p>
    </div>
}