@* @model IEnumerable<CaloryCalcLibrary.Product> *@
@using X.PagedList.Mvc.Core
@using Microsoft.AspNetCore.Mvc;

@model X.PagedList.IPagedList<CaloryCalcApp.Web.Models.DTOs.Products.ProductDto>
@{
    ViewData["Title"] = "Index";
}

<h1>Products</h1>

<p>
    <a asp-action="Create" class="btn btn-secondary">Create New</a>
</p>

<form method="get" asp-action="Index">
    <div class="mb-3 d-flex align-items-center">
        <label for="pageSize" class="form-label me-2">Items on page:</label>
        <select id="pageSize" name="pageSize" 
            onchange="this.form.submit()"
                class="form-select w-auto">
            <option value="10" selected="@(Model.PageSize == 10 ? "selected" : null)">10</option>
            <option value="20" selected="@(Model.PageSize == 20 ? "selected" : null)">20</option>
            <option value="50" selected="@(Model.PageSize == 50 ? "selected" : null)">50</option>
        </select>
    </div>
    <input type="hidden" name="oldPageSize" value="@Model.PageSize" /> 
    <input type="hidden" name="page" value="@Model.PageNumber" />
    <table class="table table-hover align-middle shadow-sm rounded-3 overflow-hidden">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.First().Name)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.First().Density)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.First().Calories)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.First().Fats)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.First().Carbohydrates)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.First().Proteins)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Name)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Density)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Calories)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Fats)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Carbohydrates)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Proteins)
                    </td>
                    <td>
                        @if (User.IsInRole("admin" ) || User.IsInRole("manager"))
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                        }
                        | <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-light">Details</a> |
                        @if (User.IsInRole("admin") || User.IsInRole("manager"))
                        {
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    
</form>

@* Let's display the page numbers at the bottom *@
<br />
Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount
@* @Html.PagedListPager(Model, page => Url.Action("Index", new { page, pageSize = Model.PageSize })) *@
@* @Html.PagedListPager(Model, page => Url.Action("Index", new { page, pageSize = Model.PageSize })) *@
@Html.PagedListPager(
Model,
page => Url.Action("Index", new { page, pageSize = Model.PageSize }),
    new X.PagedList.Mvc.Core.PagedListRenderOptions
    {
        LiElementClasses = new[] { "page-item" },
        PageClasses = new[] { "page-link" },
        UlElementClasses = new[] { "pagination", "justify-content-center" }
    }
)

