@using CaloryCalcApp.WebAPI.Models.DTOs.HealthyUsers
@model IEnumerable<HealthyUserDTO>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">Users</h1>
        <a asp-action="Create" class="btn btn-primary">Add New User</a>
    </div>

    <div class="table-responsive rounded-3 overflow-hidden">
        <table class="table table-striped table-hover table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Id)</th>
                    <th>@Html.DisplayNameFor(model => model.Name)</th>
                    <th>@Html.DisplayNameFor(model => model.Weight)</th>
                    <th>@Html.DisplayNameFor(model => model.Height)</th>
                    <th>@Html.DisplayNameFor(model => model.DateOfBirth)</th>
                    <th>@Html.DisplayNameFor(model => model.Sex)</th>
                    <th style="width: 220px;">Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var shopUser in Model)
                {
                    <tr>
                        <td>@shopUser.Id</td>
                        <td>@shopUser.Name</td>
                        <td>@shopUser.Weight</td>
                        <td>@shopUser.Height</td>
                        <td>@shopUser.DateOfBirth.ToShortDateString()</td>
                        <td>@shopUser.Sex</td>
                        <td class="align-middle">
                            <div class="btn-group">
                                <a asp-action="Edit" asp-route-id="@shopUser.Id" class="btn btn-sm btn-warning rounded-3 m-1 align-middle">Edit</a>
                                <a asp-action="ChangePassword" asp-route-id="@shopUser.Id" class="btn btn-sm btn-secondary rounded-3 m-1 align-middle">Passw.change</a>
                                <a asp-action="Delete" asp-route-id="@shopUser.Id" class="btn btn-sm btn-danger rounded-3 m-1 align-middle">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>





