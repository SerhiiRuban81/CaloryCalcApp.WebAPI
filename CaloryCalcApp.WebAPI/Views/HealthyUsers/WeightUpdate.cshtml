@model CaloryCalcApp.Application.DTOs.HealthyUsers.HealthyUserDto

<h1>Update Weight</h1>
<div class="w-50 align-content-center">
<form asp-controller="HealthyUsers"
      asp-action="WeightUpdate"
      method="post">
    <input asp-for="Id" type="hidden" />

    <label>Weight (kg):</label>
    <input asp-for="Weight" type="number" step="0.1" class="form-control" />

    <button type="submit" class="btn btn-primary mt-2">Save</button>
</form>
</div>