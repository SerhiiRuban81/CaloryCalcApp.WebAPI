@{
    @model bool

    <div class="d-flex flex-column align-items-center text-center">
        <a asp-controller="HealthyUserDishes"
           asp-action="Create"
        style="background-color: #68c1dfff;
                border-radius: 50px;
                width: 70px;
                height: 70px;"
                class="btn d-flex align-items-center justify-content-center">
            <img style="
                    width: 100%;
                    height: 100%;"
                 src="~/images/droplet-half.svg"
                 alt="record drink" />
        </a>
        <p class="mt-2">
            Add drink
        </p>
    </div>
}
